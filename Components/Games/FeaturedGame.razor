@namespace GameVault.Components.Games
@using GameVault.Models
@inject NavigationManager Navigation
@inject GameVaultState State

@if (Game != null)
{
    <div class="featured-game-banner relative w-full rounded-[20px] overflow-hidden bg-gradient-to-r from-[#1E112A] via-[#151B2D] to-[#0F172A] border border-[#273247] shadow-2xl p-6 sm:p-8 md:p-10 mb-8 min-h-[330px] flex items-center group">
        <!-- Abstract CSS Background Shapes & Glow Beams -->
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-[#8B5CF6]/20 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 left-1/3 w-80 h-80 rounded-full bg-[#22D3EE]/15 blur-3xl pointer-events-none"></div>
        <div class="absolute inset-0 bg-[radial-gradient(#8B5CF6_1px,transparent_1px)] [background-size:24px_24px] opacity-15 pointer-events-none"></div>

        <div class="relative z-10 w-full grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <!-- Left Section (60%) -->
            <div class="md:col-span-7 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-3">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#8B5CF6]/20 text-[#8B5CF6] border border-[#8B5CF6]/40 backdrop-blur-md">
                        <AppIcon Name="sparkles" CssClass="w-3.5 h-3.5" />
                        FEATURED GAME
                    </span>
                    <div class="flex items-center gap-1 text-xs font-semibold text-amber-400 bg-black/40 px-2.5 py-1 rounded-full border border-white/10">
                        <AppIcon Name="star" CssClass="w-3.5 h-3.5" Fill="true" />
                        <span>@Game.Rating.ToString("F1")</span>
                    </div>
                </div>

                <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-heading text-white tracking-tight leading-tight">
                    @Game.Title
                </h2>

                <div class="flex flex-wrap items-center gap-2 my-3">
                    @foreach (var genre in Game.Genres)
                    {
                        <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-[#1D263A] text-[#94A3B8] border border-[#273247]">
                            @genre
                        </span>
                    }
                </div>

                <p class="text-sm md:text-base text-[#94A3B8] max-w-xl leading-relaxed mb-6">
                    @Game.ShortDescription
                </p>

                <!-- Actions -->
                <div class="flex flex-wrap items-center gap-3">
                    <button type="button"
                            @onclick="NavigateToDetails"
                            class="px-6 py-3 rounded-xl bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-semibold text-sm transition-all duration-150 flex items-center gap-2 shadow-lg shadow-[#8B5CF6]/30 hover:scale-[1.02] active:scale-[0.98]">
                        <AppIcon Name="eye" CssClass="w-4 h-4" />
                        <span>View Details</span>
                    </button>

                    <button type="button"
                            @onclick="ToggleWishlist"
                            class="px-5 py-3 rounded-xl border border-[#273247] bg-[#1D263A]/80 hover:bg-[#273247] text-white font-semibold text-sm transition-all flex items-center gap-2 hover:border-[#8B5CF6]/50">
                        <AppIcon Name="heart" CssClass="@($"w-4 h-4 {(IsWishlisted ? "text-[#EF4444]" : "text-[#94A3B8]")}")" Fill="@IsWishlisted" />
                        <span>@(IsWishlisted ? "In Wishlist" : "Add to Wishlist")</span>
                    </button>
                </div>
            </div>

            <!-- Right Section (40%) - Stylized CSS Cinematic Artwork -->
            <div class="md:col-span-5 hidden md:flex items-center justify-center relative">
                <div class="relative w-full max-w-[340px] aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border border-white/10 group-hover:border-[#8B5CF6]/50 transition-all duration-300">
                    <GameArt Game="@Game" Variant="hero" CssClass="w-full h-full" />
                    <!-- Dynamic Glowing Accents -->
                    <div class="absolute inset-0 bg-gradient-to-t from-[#151B2D]/80 via-transparent to-transparent"></div>
                    <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white text-xs">
                        <span class="font-bold tracking-wider uppercase text-white/90">@Game.Developer</span>
                        <span class="px-2 py-0.5 rounded bg-white/20 backdrop-blur-md font-semibold">@Game.ReleaseDate.ToString("MMM yyyy")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Game? Game { get; set; }

    private bool IsWishlisted => Game != null && State.IsWishlisted(Game.Id);

    private void NavigateToDetails()
    {
        if (Game != null)
        {
            Navigation.NavigateTo($"/games/{Game.Id}");
        }
    }

    private void ToggleWishlist()
    {
        if (Game != null)
        {
            State.ToggleWishlist(Game.Id);
        }
    }
}
