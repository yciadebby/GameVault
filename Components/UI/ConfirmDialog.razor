@namespace GameVault.Components.UI

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black/80 backdrop-blur-sm" @onclick="CancelAsync"></div>

        <!-- Dialog Box -->
        <div class="relative w-full max-w-md rounded-2xl bg-[#151B2D] border border-[#273247] p-6 shadow-2xl z-10 animate-[scaleIn_0.15s_ease-out]">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 @(IsDestructive ? "bg-[#EF4444]/15 text-[#EF4444] border border-[#EF4444]/30" : "bg-[#8B5CF6]/15 text-[#8B5CF6] border border-[#8B5CF6]/30")">
                    <AppIcon Name="@(IsDestructive ? "trash" : "trophy")" CssClass="w-6 h-6" />
                </div>
                <div>
                    <h3 class="text-lg font-bold font-heading text-white">@Title</h3>
                    <p class="text-sm text-[#94A3B8] mt-1">@Message</p>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 mt-6">
                <button type="button" @onclick="CancelAsync" class="px-4 py-2.5 rounded-xl border border-[#273247] bg-[#1D263A] text-sm font-medium text-[#F8FAFC] hover:bg-[#273247] transition-colors">
                    @CancelText
                </button>
                <button type="button" @onclick="ConfirmAsync" class="px-5 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-lg @(IsDestructive ? "bg-[#EF4444] text-white hover:bg-[#DC2626] shadow-[#EF4444]/20" : "bg-[#8B5CF6] text-white hover:bg-[#7C3AED] shadow-[#8B5CF6]/25")">
                    @ConfirmText
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public bool IsDestructive { get; set; } = true;
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task ConfirmAsync()
    {
        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync();
        }
    }

    private async Task CancelAsync()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}
