@namespace GameVault.Components.UI

<div class="relative overflow-hidden rounded-2xl bg-[#151B2D] border border-[#273247] p-5 transition-all duration-200 hover:border-[#8B5CF6]/50 hover:shadow-lg hover:shadow-[#8B5CF6]/5 group">
    <div class="flex items-start justify-between">
        <div>
            <p class="text-xs font-medium uppercase tracking-wider text-[#94A3B8]">@Title</p>
            <h3 class="text-2xl md:text-3xl font-bold font-heading text-white mt-1">@Value</h3>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="text-xs text-[#94A3B8] mt-1">@Subtitle</p>
            }
        </div>
        <div class="w-12 h-12 rounded-xl flex items-center justify-center @GetIconContainerClass()">
            <AppIcon Name="@IconName" CssClass="@GetIconCssClass()" />
        </div>
    </div>
    
    <!-- Subtle bottom ambient light accent -->
    <div class="absolute bottom-0 left-0 right-0 h-[2px] @GetAccentLineClass() opacity-70 group-hover:opacity-100 transition-opacity"></div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string IconName { get; set; } = "trophy";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Accent { get; set; } = "violet"; // violet, cyan, green, amber

    private string GetIconContainerClass() => Accent.ToLowerInvariant() switch
    {
        "cyan" => "bg-[#22D3EE]/10 text-[#22D3EE] border border-[#22D3EE]/20",
        "green" => "bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/20",
        "amber" => "bg-[#F59E0B]/10 text-[#F59E0B] border border-[#F59E0B]/20",
        _ => "bg-[#8B5CF6]/10 text-[#8B5CF6] border border-[#8B5CF6]/20"
    };

    private string GetIconCssClass() => "w-6 h-6";

    private string GetAccentLineClass() => Accent.ToLowerInvariant() switch
    {
        "cyan" => "bg-gradient-to-r from-transparent via-[#22D3EE] to-transparent",
        "green" => "bg-gradient-to-r from-transparent via-[#22C55E] to-transparent",
        "amber" => "bg-gradient-to-r from-transparent via-[#F59E0B] to-transparent",
        _ => "bg-gradient-to-r from-transparent via-[#8B5CF6] to-transparent"
    };
}
