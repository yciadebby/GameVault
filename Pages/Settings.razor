@page "/settings"
@namespace GameVault.Pages
@using GameVault.Models
@inject GameVaultState State
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>GameVault — Settings</PageTitle>

<PageHeader Title="Settings"
            Subtitle="Personalize your GameVault experience, visual themes, and demo preferences."
            Badge="PREFERENCES" />

<div class="max-w-4xl space-y-8 pb-12">
    <!-- Panel 1: Appearance Settings -->
    <div class="p-6 md:p-8 rounded-2xl bg-[#151B2D] border border-[#273247] shadow-sm">
        <h3 class="text-lg font-bold font-heading text-white mb-1 flex items-center gap-2">
            <AppIcon Name="sparkles" CssClass="w-5 h-5 text-[#8B5CF6]" />
            <span>Appearance & Theme</span>
        </h3>
        <p class="text-xs text-[#94A3B8] mb-6">Customize interface illumination, color accents, and motion behavior.</p>

        <div class="space-y-6">
            <!-- Theme Selection -->
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-[#94A3B8] mb-3">Theme Mode</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <button type="button"
                            id="theme-btn-dark"
                            @onclick='() => SetTheme("Dark")'
                            class="p-4 rounded-xl border text-left transition-all flex items-center gap-3.5 @(State.Preferences.Theme == "Dark" ? "bg-[#101625] border-[#8B5CF6] ring-1 ring-[#8B5CF6] text-white" : "bg-[#101625]/50 border-[#273247] text-[#94A3B8] hover:border-[#8B5CF6]/50")">
                        <div class="theme-dark-preview w-10 h-10 rounded-lg bg-[#0B0F19] border border-[#273247] flex items-center justify-center text-[#8B5CF6]">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                        </div>
                        <div>
                            <div class="text-sm font-bold text-white">Dark Mode (Default)</div>
                            <div class="text-xs text-[#94A3B8]">Deep navy & obsidian surfaces for gaming focus</div>
                        </div>
                    </button>

                    <button type="button"
                            id="theme-btn-light"
                            @onclick='() => SetTheme("Light")'
                            class="p-4 rounded-xl border text-left transition-all flex items-center gap-3.5 @(State.Preferences.Theme == "Light" ? "bg-[#101625] border-[#8B5CF6] ring-1 ring-[#8B5CF6] text-white" : "bg-[#101625]/50 border-[#273247] text-[#94A3B8] hover:border-[#8B5CF6]/50")">
                        <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                        </div>
                        <div>
                            <div class="text-sm font-bold text-white">Light Mode</div>
                            <div class="text-xs text-[#94A3B8]">High contrast crisp slate palette</div>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Accent Color Selection -->
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-[#94A3B8] mb-3">Accent Color</label>
                <div class="flex items-center gap-4 flex-wrap">
                    <button type="button"
                            @onclick='() => SetAccent("Violet")'
                            class="px-4 py-2.5 rounded-xl border flex items-center gap-2.5 transition-all @(State.Preferences.AccentColor == "Violet" ? "bg-[#101625] border-[#8B5CF6] ring-1 ring-[#8B5CF6] text-white" : "bg-[#101625]/50 border-[#273247] text-[#94A3B8]")">
                        <span class="w-3.5 h-3.5 rounded-full bg-[#8B5CF6] shadow-sm"></span>
                        <span class="text-xs font-bold">Violet Neon</span>
                    </button>

                    <button type="button"
                            @onclick='() => SetAccent("Cyan")'
                            class="px-4 py-2.5 rounded-xl border flex items-center gap-2.5 transition-all @(State.Preferences.AccentColor == "Cyan" ? "bg-[#101625] border-[#06B6D4] ring-1 ring-[#06B6D4] text-white" : "bg-[#101625]/50 border-[#273247] text-[#94A3B8]")">
                        <span class="w-3.5 h-3.5 rounded-full bg-[#06B6D4] shadow-sm"></span>
                        <span class="text-xs font-bold">Cyan Cyber</span>
                    </button>

                    <button type="button"
                            @onclick='() => SetAccent("Blue")'
                            class="px-4 py-2.5 rounded-xl border flex items-center gap-2.5 transition-all @(State.Preferences.AccentColor == "Blue" ? "bg-[#101625] border-[#3B82F6] ring-1 ring-[#3B82F6] text-white" : "bg-[#101625]/50 border-[#273247] text-[#94A3B8]")">
                        <span class="w-3.5 h-3.5 rounded-full bg-[#3B82F6] shadow-sm"></span>
                        <span class="text-xs font-bold">Electric Blue</span>
                    </button>
                </div>
            </div>

            <!-- Reduced Motion -->
            <div class="flex items-center justify-between p-4 rounded-xl bg-[#101625] border border-[#273247]">
                <div>
                    <h4 class="text-sm font-bold text-white">Reduced Motion</h4>
                    <p class="text-xs text-[#94A3B8] mt-0.5">Disable fast micro-animations and card hover liftoffs</p>
                </div>
                <input type="checkbox"
                       checked="@State.Preferences.ReducedMotion"
                       @onchange="ToggleReducedMotion"
                       class="w-5 h-5 rounded bg-[#151B2D] border-[#273247] text-[#8B5CF6] focus:ring-[#8B5CF6] cursor-pointer" />
            </div>
        </div>
    </div>

    <!-- Panel 2: Library Display Settings -->
    <div class="p-6 md:p-8 rounded-2xl bg-[#151B2D] border border-[#273247] shadow-sm">
        <h3 class="text-lg font-bold font-heading text-white mb-1 flex items-center gap-2">
            <AppIcon Name="library" CssClass="w-5 h-5 text-[#22D3EE]" />
            <span>Library Display & Density</span>
        </h3>
        <p class="text-xs text-[#94A3B8] mb-6">Control how your personal collection is displayed across pages.</p>

        <div class="space-y-4">
            <!-- Default View Mode -->
            <div class="flex items-center justify-between p-4 rounded-xl bg-[#101625] border border-[#273247]">
                <div>
                    <h4 class="text-sm font-bold text-white">Default View Layout</h4>
                    <p class="text-xs text-[#94A3B8] mt-0.5">Choose between visual cards grid or detailed list rows</p>
                </div>
                <select value="@State.Preferences.DefaultLibraryView" @onchange="ChangeDefaultView"
                        class="px-3.5 py-1.5 rounded-xl bg-[#151B2D] border border-[#273247] text-xs font-semibold text-white focus:outline-none focus:border-[#8B5CF6]">
                    <option value="Grid">Grid Cards</option>
                    <option value="List">List Rows</option>
                </select>
            </div>

            <!-- Card Density -->
            <div class="flex items-center justify-between p-4 rounded-xl bg-[#101625] border border-[#273247]">
                <div>
                    <h4 class="text-sm font-bold text-white">Card Density</h4>
                    <p class="text-xs text-[#94A3B8] mt-0.5">Adjust padding and information density in cards</p>
                </div>
                <select value="@State.Preferences.CardDensity" @onchange="ChangeCardDensity"
                        class="px-3.5 py-1.5 rounded-xl bg-[#151B2D] border border-[#273247] text-xs font-semibold text-white focus:outline-none focus:border-[#8B5CF6]">
                    <option value="Comfortable">Comfortable</option>
                    <option value="Compact">Compact</option>
                </select>
            </div>

            <!-- Show Ratings -->
            <div class="flex items-center justify-between p-4 rounded-xl bg-[#101625] border border-[#273247]">
                <div>
                    <h4 class="text-sm font-bold text-white">Display Community Ratings</h4>
                    <p class="text-xs text-[#94A3B8] mt-0.5">Show star ratings on discover and library cards</p>
                </div>
                <input type="checkbox"
                       checked="@State.Preferences.ShowRatings"
                       @onchange="ToggleShowRatings"
                       class="w-5 h-5 rounded bg-[#151B2D] border-[#273247] text-[#8B5CF6] focus:ring-[#8B5CF6] cursor-pointer" />
            </div>
        </div>
    </div>

    <!-- Panel 3: Notifications -->
    <div class="p-6 md:p-8 rounded-2xl bg-[#151B2D] border border-[#273247] shadow-sm">
        <h3 class="text-lg font-bold font-heading text-white mb-1 flex items-center gap-2">
            <AppIcon Name="bell" CssClass="w-5 h-5 text-amber-400" />
            <span>Notification Preferences (Frontend Demo)</span>
        </h3>
        <p class="text-xs text-[#94A3B8] mb-6">Manage simulated alerts for updates, wishlists, and achievements.</p>

        <div class="space-y-4">
            <div class="flex items-center justify-between p-4 rounded-xl bg-[#101625] border border-[#273247]">
                <div>
                    <h4 class="text-sm font-bold text-white">Game Updates & Releases</h4>
                    <p class="text-xs text-[#94A3B8] mt-0.5">Simulate alerts when newly released games match your interests</p>
                </div>
                <input type="checkbox"
                       checked="@State.Preferences.GameUpdatesNotification"
                       @onchange="ToggleGameUpdates"
                       class="w-5 h-5 rounded bg-[#151B2D] border-[#273247] text-[#8B5CF6] focus:ring-[#8B5CF6] cursor-pointer" />
            </div>

            <div class="flex items-center justify-between p-4 rounded-xl bg-[#101625] border border-[#273247]">
                <div>
                    <h4 class="text-sm font-bold text-white">Wishlist Reminders</h4>
                    <p class="text-xs text-[#94A3B8] mt-0.5">Receive reminders about unplayed items saved in your wishlist</p>
                </div>
                <input type="checkbox"
                       checked="@State.Preferences.WishlistRemindersNotification"
                       @onchange="ToggleWishlistReminders"
                       class="w-5 h-5 rounded bg-[#151B2D] border-[#273247] text-[#8B5CF6] focus:ring-[#8B5CF6] cursor-pointer" />
            </div>

            <div class="flex items-center justify-between p-4 rounded-xl bg-[#101625] border border-[#273247]">
                <div>
                    <h4 class="text-sm font-bold text-white">Achievement Alerts</h4>
                    <p class="text-xs text-[#94A3B8] mt-0.5">Trigger toast notifications when completing games or expanding the vault</p>
                </div>
                <input type="checkbox"
                       checked="@State.Preferences.AchievementAlertsNotification"
                       @onchange="ToggleAchievementAlerts"
                       class="w-5 h-5 rounded bg-[#151B2D] border-[#273247] text-[#8B5CF6] focus:ring-[#8B5CF6] cursor-pointer" />
            </div>
        </div>
    </div>

    <!-- Panel 4: Danger Zone -->
    <div class="p-6 md:p-8 rounded-2xl bg-[#151B2D] border border-[#EF4444]/40 shadow-sm">
        <h3 class="text-lg font-bold font-heading text-[#EF4444] mb-1 flex items-center gap-2">
            <AppIcon Name="trash" CssClass="w-5 h-5 text-[#EF4444]" />
            <span>Danger Zone</span>
        </h3>
        <p class="text-xs text-[#94A3B8] mb-6">
            Reset all local browser modifications back to the original demo state.
        </p>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-[#EF4444]/10 border border-[#EF4444]/30">
            <div>
                <h4 class="text-sm font-bold text-white">Reset Demo Data</h4>
                <p class="text-xs text-[#94A3B8] mt-0.5">
                    Restores initial mock catalog, library games, wishlist items, profile info, and local storage.
                </p>
            </div>
            <button type="button"
                    @onclick="() => ShowResetConfirm = true"
                    class="px-5 py-2.5 rounded-xl bg-[#EF4444] hover:bg-[#DC2626] text-white text-xs font-semibold shadow-md shadow-[#EF4444]/25 transition-all whitespace-nowrap self-start sm:self-auto">
                Reset Demo Data
            </button>
        </div>
    </div>
</div>

<!-- Confirm Reset Modal -->
<ConfirmDialog IsOpen="@ShowResetConfirm"
               Title="Reset Demo Data"
               Message="Are you sure you want to reset all data? This will restore initial mock games, library entries, and clear browser localStorage."
               ConfirmText="Confirm Reset"
               CancelText="Keep My Data"
               IsDestructive="true"
               OnConfirm="ConfirmReset"
               OnCancel="() => ShowResetConfirm = false" />

@code {
    private bool ShowResetConfirm { get; set; }

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= HandleStateChanged;
    }

    private async Task SetTheme(string theme)
    {
        var prefs = State.Preferences;
        prefs.Theme = theme;
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task SetAccent(string accent)
    {
        var prefs = State.Preferences;
        prefs.AccentColor = accent;
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task ToggleReducedMotion(ChangeEventArgs e)
    {
        var prefs = State.Preferences;
        prefs.ReducedMotion = (bool)(e.Value ?? false);
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task ChangeDefaultView(ChangeEventArgs e)
    {
        var prefs = State.Preferences;
        prefs.DefaultLibraryView = e.Value?.ToString() ?? "Grid";
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task ChangeCardDensity(ChangeEventArgs e)
    {
        var prefs = State.Preferences;
        prefs.CardDensity = e.Value?.ToString() ?? "Comfortable";
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task ToggleShowRatings(ChangeEventArgs e)
    {
        var prefs = State.Preferences;
        prefs.ShowRatings = (bool)(e.Value ?? true);
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task ToggleGameUpdates(ChangeEventArgs e)
    {
        var prefs = State.Preferences;
        prefs.GameUpdatesNotification = (bool)(e.Value ?? true);
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task ToggleWishlistReminders(ChangeEventArgs e)
    {
        var prefs = State.Preferences;
        prefs.WishlistRemindersNotification = (bool)(e.Value ?? true);
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task ToggleAchievementAlerts(ChangeEventArgs e)
    {
        var prefs = State.Preferences;
        prefs.AchievementAlertsNotification = (bool)(e.Value ?? true);
        await State.UpdatePreferencesAsync(prefs);
    }

    private async Task ConfirmReset()
    {
        ShowResetConfirm = false;
        await State.ResetDemoDataAsync();
    }
}
