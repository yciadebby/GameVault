@page "/not-found"
@namespace GameVault.Pages
@inject NavigationManager Navigation

<PageTitle>GameVault — 404 Lost in the Cosmos</PageTitle>

<div class="min-h-[60vh] flex flex-col items-center justify-center text-center p-6">
    <div class="relative flex items-center justify-center w-28 h-28 mb-6">
        <div class="absolute inset-0 rounded-3xl bg-[#8B5CF6]/20 blur-2xl animate-pulse"></div>
        <div class="relative w-24 h-24 rounded-3xl bg-[#151B2D] border border-[#273247] flex items-center justify-center shadow-2xl text-[#8B5CF6]">
            <AppIcon Name="compass" CssClass="w-12 h-12" />
        </div>
    </div>

    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-rose-500/15 text-rose-400 border border-rose-500/30 mb-3">
        ERROR 404 • SIGNAL LOST
    </span>

    <h1 class="text-3xl md:text-5xl font-black font-heading text-white tracking-tight mb-2">
        Lost in Deep Space
    </h1>

    <p class="text-sm md:text-base text-[#94A3B8] max-w-md mx-auto mb-8 leading-relaxed">
        The coordinates you entered led to an uncharted sector. This game, portal, or route cannot be found in your current universe.
    </p>

    <div class="flex items-center gap-4">
        <button type="button"
                @onclick='() => Navigation.NavigateTo("/")'
                class="px-5 py-2.5 rounded-xl bg-[#8B5CF6] hover:bg-[#7C3AED] text-white text-xs font-semibold shadow-lg shadow-[#8B5CF6]/30 transition-all flex items-center gap-2">
            <AppIcon Name="home" CssClass="w-4 h-4" />
            <span>Return to Dashboard</span>
        </button>

        <button type="button"
                @onclick='() => Navigation.NavigateTo("/discover")'
                class="px-5 py-2.5 rounded-xl bg-[#1D263A] hover:bg-[#273247] text-white text-xs font-semibold border border-[#273247] transition-all flex items-center gap-2">
            <AppIcon Name="compass" CssClass="w-4 h-4 text-[#8B5CF6]" />
            <span>Discover Games</span>
        </button>
    </div>
</div>