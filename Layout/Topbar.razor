@namespace GameVault.Layout
@inject GameVaultState State
@inject NavigationManager Navigation
@implements IDisposable

<header class="sticky top-0 z-30 flex items-center justify-between h-[72px] px-4 sm:px-6 md:px-8 bg-[#101625]/85 backdrop-blur-md border-b border-[#273247] select-none">
    <!-- Left Section: Hamburger & Page Title -->
    <div class="flex items-center gap-3">
        <button type="button"
                @onclick="ToggleSidebar"
                class="lg:hidden p-2 rounded-xl text-[#94A3B8] hover:text-white hover:bg-[#151B2D] border border-[#273247] transition-colors"
                aria-label="Toggle navigation drawer">
            <AppIcon Name="menu" CssClass="w-5 h-5" />
        </button>

        <div>
            <h2 class="text-base sm:text-lg font-bold font-heading text-white tracking-tight flex items-center gap-2">
                @CurrentPageTitle
            </h2>
        </div>
    </div>

    <!-- Right Section: Global Search, Notifications, Theme, User Avatar -->
    <div class="flex items-center gap-3 sm:gap-4">
        <!-- Global Search Bar (desktop) -->
        <div class="relative hidden md:block w-72 lg:w-80">
            <AppIcon Name="search" CssClass="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#94A3B8]" />
            <input type="text"
                   @bind="SearchText"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Search your next adventure..."
                   class="w-full pl-10 pr-4 py-2 rounded-xl bg-[#151B2D] border border-[#273247] text-xs sm:text-sm text-white placeholder-[#94A3B8] focus:outline-none focus:border-[#8B5CF6] focus:ring-1 focus:ring-[#8B5CF6] transition-all" />
        </div>

        <!-- Quick Theme Switch -->
        <ThemeSwitch />

        <!-- Notification Bell Dropdown -->
        <div class="relative">
            <button type="button"
                    @onclick="() => ShowNotifications = !ShowNotifications"
                    class="relative p-2.5 rounded-xl bg-[#151B2D] border border-[#273247] text-[#94A3B8] hover:text-white hover:border-[#8B5CF6]/50 transition-colors"
                    aria-label="View notifications">
                <AppIcon Name="bell" CssClass="w-4 h-4" />
                @if (UnreadNotificationsCount > 0)
                {
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[#8B5CF6] ring-2 ring-[#101625] animate-ping"></span>
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[#8B5CF6] ring-2 ring-[#101625]"></span>
                }
            </button>

            @if (ShowNotifications)
            {
                <div class="fixed inset-0 z-40" @onclick="() => ShowNotifications = false"></div>
                <div class="absolute right-0 mt-2 w-80 rounded-2xl bg-[#151B2D] border border-[#273247] shadow-2xl py-3 z-50 animate-[scaleIn_0.15s_ease-out]">
                    <div class="flex items-center justify-between px-4 pb-2.5 border-b border-[#273247]/60">
                        <span class="text-xs font-bold uppercase tracking-wider text-white">Notifications</span>
                        @if (UnreadNotificationsCount > 0)
                        {
                            <button type="button" @onclick="MarkAllAsRead" class="text-[11px] font-semibold text-[#8B5CF6] hover:underline">
                                Mark all as read
                            </button>
                        }
                    </div>

                    <div class="divide-y divide-[#273247]/40 max-h-72 overflow-y-auto">
                        @foreach (var note in Notifications)
                        {
                            <div class="p-3.5 hover:bg-[#1D263A] transition-colors flex items-start gap-3">
                                <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0 @(note.IsRead ? "bg-[#273247]" : "bg-[#8B5CF6]")"></div>
                                <div>
                                    <p class="text-xs font-semibold text-white">@note.Title</p>
                                    <p class="text-[11px] text-[#94A3B8] mt-0.5">@note.Message</p>
                                    <span class="text-[10px] text-[#94A3B8]/70 mt-1 block">@note.Time</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Profile Avatar Button -->
        <button type="button"
                @onclick="NavigateToProfile"
                class="flex items-center gap-2.5 p-1 rounded-xl hover:bg-[#151B2D] transition-colors group"
                aria-label="User Profile">
            <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-[#8B5CF6] to-[#22D3EE] flex items-center justify-center font-bold text-white text-xs shadow-md group-hover:scale-105 transition-transform">
                @State.Profile.AvatarInitials
            </div>
        </button>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    private string SearchText { get; set; } = string.Empty;
    private bool ShowNotifications { get; set; }

    private class NotificationItem
    {
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string Time { get; set; } = string.Empty;
        public bool IsRead { get; set; }
    }

    private List<NotificationItem> Notifications = new()
    {
        new NotificationItem { Title = "Welcome to GameVault!", Message = "Your universe of games is ready to explore.", Time = "Just now", IsRead = false },
        new NotificationItem { Title = "Your gaming library is ready", Message = "11 catalog games have been synced to your local collection.", Time = "10m ago", IsRead = false },
        new NotificationItem { Title = "Explore your next adventure", Message = "Check out newly added games in the Discover section.", Time = "1h ago", IsRead = false }
    };

    private int UnreadNotificationsCount => Notifications.Count(n => !n.IsRead);

    private string CurrentPageTitle
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (string.IsNullOrWhiteSpace(relative)) return "Dashboard";
            if (relative.StartsWith("discover", StringComparison.OrdinalIgnoreCase)) return "Discover Games";
            if (relative.StartsWith("library", StringComparison.OrdinalIgnoreCase)) return "My Library";
            if (relative.StartsWith("wishlist", StringComparison.OrdinalIgnoreCase)) return "Wishlist";
            if (relative.StartsWith("games", StringComparison.OrdinalIgnoreCase)) return "Game Details";
            if (relative.StartsWith("profile", StringComparison.OrdinalIgnoreCase)) return "Profile";
            if (relative.StartsWith("settings", StringComparison.OrdinalIgnoreCase)) return "Settings";
            return "Dashboard";
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        State.OnChange += HandleStateChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        State.OnChange -= HandleStateChanged;
    }

    private async Task ToggleSidebar()
    {
        if (OnToggleSidebar.HasDelegate)
        {
            await OnToggleSidebar.InvokeAsync();
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SearchText))
        {
            var query = Uri.EscapeDataString(SearchText.Trim());
            SearchText = string.Empty;
            Navigation.NavigateTo($"/discover?q={query}");
        }
    }

    private void MarkAllAsRead()
    {
        foreach (var note in Notifications)
        {
            note.IsRead = true;
        }
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/profile");
    }
}
