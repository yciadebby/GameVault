@namespace GameVault.Components.UI

<div class="rounded-2xl bg-[#151B2D] border border-[#273247] p-4 flex flex-col gap-4 animate-pulse">
    <!-- Art placeholder -->
    <div class="w-full aspect-[3/4] rounded-xl bg-[#1D263A] relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent animate-[shimmer_1.5s_infinite]"></div>
    </div>
    <!-- Title placeholder -->
    <div class="h-5 bg-[#1D263A] rounded-md w-3/4"></div>
    <!-- Subtitle / Meta -->
    <div class="flex items-center justify-between">
        <div class="h-4 bg-[#1D263A] rounded w-1/3"></div>
        <div class="h-4 bg-[#1D263A] rounded w-1/4"></div>
    </div>
</div>
