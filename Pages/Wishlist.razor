@page "/wishlist"
@namespace GameVault.Pages
@inject GameVaultState State
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>GameVault — Wishlist</PageTitle>

<!-- Header -->
<PageHeader Title="My Wishlist"
            Subtitle="Every game you want to experience next in your journey."
            Badge="SAVED FOR LATER">
    <Actions>
        <div class="px-4 py-2 rounded-xl bg-[#151B2D] border border-[#273247] text-xs font-semibold text-[#94A3B8]">
            <span class="text-white font-bold">@WishlistGames.Count</span> Saved Games
        </div>
    </Actions>
</PageHeader>

<!-- Wishlist Grid -->
@if (WishlistGames.Count > 0)
{
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        @foreach (var game in WishlistGames)
        {
            var isOwned = State.IsInLibrary(game.Id);

            <div @key="game.Id" class="group relative flex flex-col rounded-2xl bg-[#151B2D] border border-[#273247] p-4 transition-all duration-200 hover:-translate-y-1 hover:border-[#8B5CF6]/60 hover:shadow-xl hover:shadow-[#8B5CF6]/10">
                <!-- Cover with Wishlist Heart -->
                <div class="relative w-full aspect-[3/4] rounded-xl overflow-hidden mb-3.5 bg-[#101625]">
                    <GameArt Game="@game" Variant="md" CssClass="w-full h-full transition-transform duration-300 group-hover:scale-105" />

                    <!-- Heart toggle -->
                    <button type="button"
                            @onclick="() => State.RemoveFromWishlist(game.Id)"
                            class="absolute top-2.5 right-2.5 w-9 h-9 rounded-full bg-[#101625]/80 backdrop-blur-md border border-white/10 flex items-center justify-center transition-all hover:scale-110 active:scale-95 text-[#EF4444]"
                            title="Remove from wishlist"
                            aria-label="Remove from wishlist">
                        <AppIcon Name="heart" CssClass="w-5 h-5" Fill="true" />
                    </button>

                    @if (isOwned)
                    {
                        <div class="absolute top-2.5 left-2.5">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#22C55E]/80 backdrop-blur-md text-white border border-[#22C55E]">
                                In Library
                            </span>
                        </div>
                    }
                </div>

                <!-- Info -->
                <div class="flex-1 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between text-xs text-[#94A3B8] mb-1">
                            <span class="font-medium">@game.ReleaseDate.Year</span>
                            <div class="flex items-center gap-1 text-white font-semibold">
                                <AppIcon Name="star" CssClass="w-3.5 h-3.5 text-[#F59E0B]" Fill="true" />
                                <span>@game.Rating.ToString("F1")</span>
                            </div>
                        </div>

                        <h3 class="text-base font-bold font-heading text-white line-clamp-1 group-hover:text-[#8B5CF6] transition-colors cursor-pointer" @onclick='() => Navigation.NavigateTo($"/games/{game.Id}")'>
                            @game.Title
                        </h3>

                        <p class="text-xs text-[#94A3B8] line-clamp-2 mt-1 leading-relaxed">
                            @game.ShortDescription
                        </p>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center gap-2 mt-4 pt-3 border-t border-[#273247]/60">
                        @if (isOwned)
                        {
                            <button type="button"
                                    disabled
                                    class="flex-1 py-2 px-3 rounded-xl bg-[#22C55E]/15 text-[#22C55E] border border-[#22C55E]/30 text-xs font-semibold text-center cursor-default">
                                In Library
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    @onclick="() => State.AddToLibrary(game.Id)"
                                    class="flex-1 py-2 px-3 rounded-xl bg-[#8B5CF6] hover:bg-[#7C3AED] text-white text-xs font-semibold tracking-wide transition-all text-center shadow-md shadow-[#8B5CF6]/25">
                                Add to Library
                            </button>
                        }

                        <button type="button"
                                @onclick='() => Navigation.NavigateTo($"/games/{game.Id}")'
                                class="p-2 rounded-xl bg-[#1D263A] hover:bg-[#273247] text-[#94A3B8] hover:text-white transition-colors border border-[#273247]"
                                title="View Game Details"
                                aria-label="View Game Details">
                            <AppIcon Name="eye" CssClass="w-4 h-4" />
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <EmptyState IconName="heart"
                Title="Your wishlist is empty"
                Description="Explore the catalog and save the games you want to play to view them here."
                ActionText="Discover Games"
                ActionIcon="compass"
                OnAction='() => Navigation.NavigateTo("/discover")' />
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= HandleStateChanged;
    }

    private List<Game> WishlistGames => State.GetWishlistGames();
}
