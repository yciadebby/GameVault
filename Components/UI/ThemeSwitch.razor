@namespace GameVault.Components.UI
@inject GameVaultState State
@implements IDisposable

<button type="button"
        @onclick="ToggleThemeAsync"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-[#273247] bg-[#151B2D] text-xs font-semibold text-[#F8FAFC] hover:bg-[#1D263A] hover:border-[#8B5CF6]/40 transition-all shadow-sm"
        title="Toggle Dark/Light Mode"
        aria-label="Toggle Theme Mode">
    @if (State.Preferences.Theme == "Light")
    {
        <!-- Sun icon -->
        <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <span>Light Mode</span>
    }
    else
    {
        <!-- Moon icon -->
        <svg class="w-4 h-4 text-[#8B5CF6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
        <span>Dark Mode</span>
    }
</button>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= HandleStateChanged;
    }

    private async Task ToggleThemeAsync()
    {
        var prefs = State.Preferences;
        prefs.Theme = prefs.Theme == "Light" ? "Dark" : "Light";
        await State.UpdatePreferencesAsync(prefs);
    }
}
