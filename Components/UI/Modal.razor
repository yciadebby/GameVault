@namespace GameVault.Components.UI

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 overflow-y-auto" role="dialog" aria-modal="true" @onkeydown="HandleKeyDown">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black/75 backdrop-blur-sm transition-opacity" @onclick="CloseAsync"></div>

        <!-- Modal Card -->
        <div class="relative w-full @GetMaxWidthClass() rounded-2xl bg-[#151B2D] border border-[#273247] shadow-2xl overflow-hidden z-10 my-8 transition-all transform animate-[scaleIn_0.15s_ease-out]">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[#273247]">
                <h3 class="text-lg md:text-xl font-bold font-heading text-white">@Title</h3>
                <button type="button" @onclick="CloseAsync" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#94A3B8] hover:text-white hover:bg-[#1D263A] transition-colors" aria-label="Close modal">
                    <AppIcon Name="close" CssClass="w-5 h-5" />
                </button>
            </div>

            <!-- Body -->
            <div class="p-6 max-h-[75vh] overflow-y-auto">
                @ChildContent
            </div>

            <!-- Footer (optional) -->
            @if (FooterContent != null)
            {
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[#273247] bg-[#101625]/60">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string Size { get; set; } = "md"; // sm, md, lg, xl

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private string GetMaxWidthClass() => Size.ToLowerInvariant() switch
    {
        "sm" => "max-w-md",
        "lg" => "max-w-3xl",
        "xl" => "max-w-4xl",
        _ => "max-w-xl"
    };
}
