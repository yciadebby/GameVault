@page "/discover"
@namespace GameVault.Pages
@inject GameVaultState State
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>GameVault — Discover Games</PageTitle>

<!-- Header -->
<PageHeader Title="Discover Games"
            Subtitle="Explore new worlds, futuristic epics, and discover your next favorite game."
            Badge="CATALOG EXPLORER">
    <Actions>
        <div class="px-4 py-2 rounded-xl bg-[#151B2D] border border-[#273247] text-xs font-semibold text-[#94A3B8]">
            Showing <span class="text-white font-bold">@FilteredGames.Count</span> of @State.GetAllGames().Count Games
        </div>
    </Actions>
</PageHeader>

<!-- Search and Filter Toolbar -->
<GameFilterBar SearchQuery="@SearchQuery"
               SearchQueryChanged="OnSearchChanged"
               SelectedGenre="@SelectedGenre"
               SelectedGenreChanged="OnGenreChanged"
               SelectedPlatform="@SelectedPlatform"
               SelectedPlatformChanged="OnPlatformChanged"
               SelectedSort="@SelectedSort"
               SelectedSortChanged="OnSortChanged"
               IsListView="@IsListView"
               IsListViewChanged="OnViewModeChanged"
               OnClearFilters="ResetFilters" />

<!-- Quick Genre Filter Chips -->
<div class="mb-6 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
    <span class="text-xs font-semibold text-[#94A3B8] uppercase tracking-wider flex-shrink-0 mr-1">Quick Filter:</span>
    <button type="button"
            @onclick='() => SetGenre("")'
            class="px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-all @(string.IsNullOrEmpty(SelectedGenre) ? "bg-[#8B5CF6] text-white shadow-md shadow-[#8B5CF6]/30" : "bg-[#151B2D] text-[#94A3B8] hover:text-white border border-[#273247]")">
        All Genres
    </button>
    @foreach (var genre in AvailableGenres)
    {
        var isSel = string.Equals(SelectedGenre, genre, StringComparison.OrdinalIgnoreCase);
        <button type="button"
                @onclick="() => SetGenre(genre)"
                class="px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-all @(isSel ? "bg-[#8B5CF6] text-white shadow-md shadow-[#8B5CF6]/30" : "bg-[#151B2D] text-[#94A3B8] hover:text-white border border-[#273247]")">
            @genre
        </button>
    }
</div>

<!-- Game Catalog Listing -->
@if (FilteredGames.Count > 0)
{
    @if (IsListView)
    {
        <div class="space-y-3">
            @foreach (var game in FilteredGames)
            {
                <GameRow @key="game.Id" Game="@game" />
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var game in FilteredGames)
            {
                <GameCard @key="game.Id" Game="@game" />
            }
        </div>
    }
}
else
{
    <EmptyState IconName="search"
                Title="No games found"
                Description="Try adjusting your search terms or clearing your active filters to view available games."
                ActionText="Clear All Filters"
                ActionIcon="rotate-ccw"
                OnAction="ResetFilters" />
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? QueryParam { get; set; }

    private string SearchQuery { get; set; } = string.Empty;
    private string SelectedGenre { get; set; } = string.Empty;
    private string SelectedPlatform { get; set; } = string.Empty;
    private string SelectedSort { get; set; } = "az";
    private bool IsListView { get; set; } = false;

    private readonly List<string> AvailableGenres = new()
    {
        "Action", "Adventure", "RPG", "Strategy", "Simulation", "Racing", "Puzzle", "Indie", "Horror"
    };

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChanged;
        if (!string.IsNullOrWhiteSpace(QueryParam))
        {
            SearchQuery = QueryParam;
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(QueryParam) && QueryParam != SearchQuery)
        {
            SearchQuery = QueryParam;
        }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= HandleStateChanged;
    }

    private List<Game> FilteredGames
    {
        get
        {
            var query = State.GetAllGames().AsEnumerable();

            // Search filter
            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var term = SearchQuery.Trim();
                query = query.Where(g =>
                    g.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    g.PrimaryGenre.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    g.Developer.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    g.Genres.Any(genre => genre.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            // Genre filter
            if (!string.IsNullOrWhiteSpace(SelectedGenre))
            {
                query = query.Where(g =>
                    string.Equals(g.PrimaryGenre, SelectedGenre, StringComparison.OrdinalIgnoreCase) ||
                    g.Genres.Any(genre => string.Equals(genre, SelectedGenre, StringComparison.OrdinalIgnoreCase)));
            }

            // Platform filter
            if (!string.IsNullOrWhiteSpace(SelectedPlatform))
            {
                query = query.Where(g => g.Platforms.Any(p => string.Equals(p, SelectedPlatform, StringComparison.OrdinalIgnoreCase)));
            }

            // Sorting
            query = SelectedSort switch
            {
                "za" => query.OrderByDescending(g => g.Title),
                "rating_desc" => query.OrderByDescending(g => g.Rating).ThenBy(g => g.Title),
                "rating_asc" => query.OrderBy(g => g.Rating).ThenBy(g => g.Title),
                "newest" => query.OrderByDescending(g => g.ReleaseDate),
                "oldest" => query.OrderBy(g => g.ReleaseDate),
                _ => query.OrderBy(g => g.Title)
            };

            return query.ToList();
        }
    }

    private void OnSearchChanged(string val) => SearchQuery = val;
    private void OnGenreChanged(string val) => SelectedGenre = val;
    private void OnPlatformChanged(string val) => SelectedPlatform = val;
    private void OnSortChanged(string val) => SelectedSort = val;
    private void OnViewModeChanged(bool val) => IsListView = val;
    private void SetGenre(string genre) => SelectedGenre = genre;

    private void ResetFilters()
    {
        SearchQuery = string.Empty;
        SelectedGenre = string.Empty;
        SelectedPlatform = string.Empty;
        SelectedSort = "az";
    }
}
